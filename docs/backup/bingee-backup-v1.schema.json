{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bingee.app/schema/bingee-backup-v1.schema.json",
  "title": "Bingee backup v1",
  "type": "object",
  "required": ["formatId", "schemaVersion", "exportedAt", "data"],
  "properties": {
    "formatId": {"const": "bingee-backup"},
    "schemaVersion": {"const": 1},
    "exportedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "data": {"$ref": "#/$defs/data"}
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["source", "externalId"],
      "properties": {
        "source": {"enum": ["TMDB"]},
        "externalId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mediaIdentity": {
      "type": "object",
      "required": ["source", "mediaType", "externalId"],
      "properties": {
        "source": {"enum": ["TMDB"]},
        "mediaType": {"enum": ["MOVIE", "SERIES"]},
        "externalId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["primaryRef", "externalRefs", "mediaType", "title", "originalTitle", "overview", "posterUrl", "releaseDate"],
      "properties": {
        "primaryRef": {"$ref": "#/$defs/ref"},
        "externalRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
        "mediaType": {"enum": ["MOVIE", "SERIES"]},
        "title": {"type": "string", "minLength": 1},
        "originalTitle": {"type": ["string", "null"]},
        "overview": {"type": ["string", "null"]},
        "posterUrl": {"type": ["string", "null"]},
        "releaseDate": {"type": ["string", "null"], "format": "date"},
        "isFavorite": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "movieProgress": {
      "type": "object",
      "required": ["mediaRef", "watchedAt"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "watchedAt": {"type": "string", "format": "date-time"},
        "watchedDate": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    },
    "seriesProgress": {
      "type": "object",
      "required": ["mediaRef", "completedAt"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "completedAt": {"type": "string", "format": "date-time"},
        "watchedDate": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["media", "seasons", "episodes", "library", "movieProgress", "episodeProgress", "ratings", "preferences"],
      "properties": {
        "media": {"type": "array", "items": {"$ref": "#/$defs/media"}},
        "seasons": {"type": "array", "items": {"type": "object"}},
        "episodes": {"type": "array", "items": {"type": "object"}},
        "library": {"type": "array", "items": {"type": "object"}},
        "movieProgress": {"type": "array", "items": {"$ref": "#/$defs/movieProgress"}},
        "seriesProgress": {"type": "array", "items": {"$ref": "#/$defs/seriesProgress"}},
        "episodeProgress": {"type": "array", "items": {"type": "object"}},
        "ratings": {"type": "array", "items": {"type": "object"}},
        "preferences": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
