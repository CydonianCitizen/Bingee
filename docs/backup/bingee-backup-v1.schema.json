{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bingee.app/schema/bingee-backup-v1.schema.json",
  "title": "Bingee backup v1",
  "type": "object",
  "required": ["formatId", "schemaVersion", "exportedAt", "data"],
  "properties": {
    "formatId": {"const": "bingee-backup"},
    "schemaVersion": {"const": 1},
    "exportedAt": {"type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64},
    "data": {"$ref": "#/$defs/data"}
  },
  "additionalProperties": true,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["source", "externalId"],
      "properties": {
        "source": {"const": "TMDB"},
        "externalId": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[1-9][0-9]*$"}
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "required": ["primaryRef", "externalRefs", "mediaType", "title"],
      "properties": {
        "primaryRef": {"$ref": "#/$defs/ref"},
        "externalRefs": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"$ref": "#/$defs/ref"}},
        "mediaType": {"enum": ["MOVIE", "SERIES"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 8192},
        "originalTitle": {"type": ["string", "null"], "maxLength": 8192},
        "overview": {"type": ["string", "null"], "maxLength": 8192},
        "posterUrl": {"type": ["string", "null"], "maxLength": 2048},
        "releaseDate": {"type": ["string", "null"], "format": "date"},
        "isFavorite": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "season": {
      "type": "object",
      "required": ["mediaRef", "externalRef", "seasonNumber", "episodeCount"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "externalRef": {"$ref": "#/$defs/ref"},
        "seasonNumber": {"type": "integer", "minimum": 0},
        "name": {"type": ["string", "null"], "maxLength": 8192},
        "overview": {"type": ["string", "null"], "maxLength": 8192},
        "posterUrl": {"type": ["string", "null"], "maxLength": 2048},
        "airDate": {"type": ["string", "null"], "format": "date"},
        "episodeCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "episode": {
      "type": "object",
      "required": ["seasonRef", "externalRef", "episodeNumber", "title"],
      "properties": {
        "seasonRef": {"$ref": "#/$defs/ref"},
        "externalRef": {"$ref": "#/$defs/ref"},
        "episodeNumber": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 8192},
        "overview": {"type": ["string", "null"], "maxLength": 8192},
        "airDate": {"type": ["string", "null"], "format": "date"},
        "runtimeMinutes": {"type": ["integer", "null"], "minimum": 1},
        "stillUrl": {"type": ["string", "null"], "maxLength": 2048}
      },
      "additionalProperties": true
    },
    "library": {
      "type": "object",
      "required": ["mediaRef", "addedAt"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "addedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "movieProgress": {
      "type": "object",
      "required": ["mediaRef", "watchedAt"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "watchedAt": {"type": "string", "format": "date-time"},
        "watchedDate": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": true
    },
    "seriesProgress": {
      "type": "object",
      "required": ["mediaRef", "completedAt"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "completedAt": {"type": "string", "format": "date-time"},
        "watchedDate": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": true
    },
    "abandonedSeries": {
      "type": "object",
      "required": ["mediaRef"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"}
      },
      "additionalProperties": true
    },
    "episodeProgress": {
      "type": "object",
      "required": ["episodeRef", "watchedAt"],
      "properties": {
        "episodeRef": {"$ref": "#/$defs/ref"},
        "watchedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "rating": {
      "type": "object",
      "required": ["mediaRef", "rating", "ratedAt", "updatedAt"],
      "properties": {
        "mediaRef": {"$ref": "#/$defs/ref"},
        "rating": {"type": "integer", "minimum": 1, "maximum": 10},
        "ratedAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "preferences": {
      "type": "object",
      "required": ["notificationLeadDays", "notifyMovieReleases", "notifySeasonPremieres", "notifyEpisodeAirings"],
      "properties": {
        "notificationLeadDays": {"enum": [0, 1, 3, 7]},
        "notifyMovieReleases": {"type": "boolean"},
        "notifySeasonPremieres": {"type": "boolean"},
        "notifyEpisodeAirings": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": ["media", "seasons", "episodes", "library", "movieProgress", "episodeProgress", "ratings", "preferences"],
      "properties": {
        "media": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/media"}},
        "seasons": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/season"}},
        "episodes": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/episode"}},
        "library": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/library"}},
        "movieProgress": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/movieProgress"}},
        "seriesProgress": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/seriesProgress"}},
        "abandonedSeries": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/abandonedSeries"}},
        "episodeProgress": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/episodeProgress"}},
        "ratings": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/rating"}},
        "preferences": {"$ref": "#/$defs/preferences"}
      },
      "additionalProperties": true
    }
  }
}
